/* Shared rofi styling for drun/run/window/dmenu modes (app launcher, clipboard
 * picker, theme picker, etc). Colors come from theme.rasi, which `just apply`
 * regenerates on every theme switch — this file only holds layout/structure. */

@import "~/.config/rofi/theme.rasi"

* {
    font: "JetBrainsMono Nerd Font 12";
}

window {
    width:            700px;
    border:           2px;
    border-radius:    10px;
    border-color:     @main-br;
    background-color: @main-bg;
}

mainbox {
    background-color: @main-bg;
    padding:           10px;
}

inputbar {
    children:          [ prompt, entry ];
    background-color:  @input-bg;
    border-radius:     8px;
    padding:           8px 10px;
    margin:            0px 0px 10px 0px;
}

prompt {
    background-color: transparent;
    text-color:        @main-fg;
    padding:           0px 8px 0px 0px;
}

entry {
    background-color: transparent;
    text-color:        @main-fg;
    placeholder-color: @select-bg;
}

listview {
    columns:           1;
    lines:             10;
    spacing:           4px;
    fixed-height:      false;
    background-color:  @main-bg;
}

element {
    padding:           8px 10px;
    border-radius:     8px;
    background-color:  @main-bg;
    text-color:        @main-fg;
}

element-icon, element-text {
    background-color: inherit;
    text-color:        inherit;
}

element-icon {
    size:              64px;
    padding:           0px 10px 0px 0px;
}

element-text {
    vertical-align:    0.5;
}

element selected {
    background-color:  @select-bg;
    text-color:        @select-fg;
}

element alternate.normal {
    background-color:  @main-bg;
}

scrollbar {
    handle-color:      @select-bg;
    handle-width:      6px;
}

message {
    background-color:  @input-bg;
    text-color:        @main-fg;
    border-radius:     8px;
    padding:           8px;
}
