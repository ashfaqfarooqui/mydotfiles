---
whiskers:
    version: "^2.4.0"
    matrix:
        - flavor
    filename: "generated/{{flavor.identifier}}/kitty-font.conf"
font_family: "JetBrainsMono Nerd Font"
---
# Font for kitty. Generated by theme/justfile from theme/font.json — do not
# edit directly, edit theme/font.json instead. Not flavor-dependent (font
# doesn't change per Catppuccin flavor), but rendered per-flavor like every
# other template so `just apply <flavor>` can copy it the same way.
font_family      family="{{ font_family }}"
bold_font        auto
italic_font      auto
bold_italic_font auto
