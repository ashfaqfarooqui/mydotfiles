---
whiskers:
    version: "^2.4.0"
    matrix:
        - flavor
    filename: "generated/{{flavor.identifier}}/emacs-theme.el"
---
;;; theme-generated-theme.el --- Catppuccin {{ flavor.name }}, generated -*- lexical-binding: t; no-byte-compile: t; -*-
;; Generated by theme/justfile — do not edit directly, edit theme/emacs.tera instead.

(deftheme theme-generated "Generated from the unified dotfiles theme palette.")

(let ((text "#{{ flavor.colors.text.hex }}")
      (subtext1 "#{{ flavor.colors.subtext1.hex }}")
      (subtext0 "#{{ flavor.colors.subtext0.hex }}")
      (overlay2 "#{{ flavor.colors.overlay2.hex }}")
      (overlay1 "#{{ flavor.colors.overlay1.hex }}")
      (overlay0 "#{{ flavor.colors.overlay0.hex }}")
      (surface2 "#{{ flavor.colors.surface2.hex }}")
      (surface1 "#{{ flavor.colors.surface1.hex }}")
      (surface0 "#{{ flavor.colors.surface0.hex }}")
      (base "#{{ flavor.colors.base.hex }}")
      (mantle "#{{ flavor.colors.mantle.hex }}")
      (crust "#{{ flavor.colors.crust.hex }}")
      (red "#{{ flavor.colors.red.hex }}")
      (maroon "#{{ flavor.colors.maroon.hex }}")
      (peach "#{{ flavor.colors.peach.hex }}")
      (yellow "#{{ flavor.colors.yellow.hex }}")
      (green "#{{ flavor.colors.green.hex }}")
      (teal "#{{ flavor.colors.teal.hex }}")
      (sky "#{{ flavor.colors.sky.hex }}")
      (sapphire "#{{ flavor.colors.sapphire.hex }}")
      (blue "#{{ flavor.colors.blue.hex }}")
      (lavender "#{{ flavor.colors.lavender.hex }}")
      (mauve "#{{ flavor.colors.mauve.hex }}")
      (pink "#{{ flavor.colors.pink.hex }}")
      (flamingo "#{{ flavor.colors.flamingo.hex }}")
      (rosewater "#{{ flavor.colors.rosewater.hex }}"))
  (custom-theme-set-faces
   'theme-generated
   `(default ((t (:foreground ,text :background ,base))))
   `(cursor ((t (:background ,rosewater))))
   `(fringe ((t (:background ,base))))
   `(region ((t (:background ,surface1))))
   `(secondary-selection ((t (:background ,surface0))))
   `(highlight ((t (:background ,surface0))))
   `(hl-line ((t (:background ,surface0))))
   `(shadow ((t (:foreground ,overlay0))))
   `(minibuffer-prompt ((t (:foreground ,blue :weight bold))))
   `(vertical-border ((t (:foreground ,surface0))))
   `(window-divider ((t (:foreground ,surface0))))
   `(header-line ((t (:foreground ,text :background ,mantle))))
   `(mode-line ((t (:foreground ,text :background ,mantle))))
   `(mode-line-inactive ((t (:foreground ,overlay0 :background ,mantle))))
   `(mode-line-buffer-id ((t (:foreground ,blue :weight bold))))
   `(line-number ((t (:foreground ,overlay0 :background ,base))))
   `(line-number-current-line ((t (:foreground ,lavender :background ,surface0 :weight bold))))

   `(font-lock-comment-face ((t (:foreground ,overlay1 :slant italic))))
   `(font-lock-comment-delimiter-face ((t (:foreground ,overlay1))))
   `(font-lock-doc-face ((t (:foreground ,overlay2 :slant italic))))
   `(font-lock-string-face ((t (:foreground ,green))))
   `(font-lock-keyword-face ((t (:foreground ,mauve))))
   `(font-lock-builtin-face ((t (:foreground ,mauve))))
   `(font-lock-function-name-face ((t (:foreground ,blue))))
   `(font-lock-variable-name-face ((t (:foreground ,flamingo))))
   `(font-lock-type-face ((t (:foreground ,yellow))))
   `(font-lock-constant-face ((t (:foreground ,peach))))
   `(font-lock-negation-char-face ((t (:foreground ,sky))))
   `(font-lock-preprocessor-face ((t (:foreground ,mauve))))
   `(font-lock-warning-face ((t (:foreground ,yellow :weight bold))))
   `(font-lock-number-face ((t (:foreground ,peach))))
   `(font-lock-operator-face ((t (:foreground ,sky))))
   `(font-lock-punctuation-face ((t (:foreground ,overlay2))))
   `(font-lock-property-face ((t (:foreground ,teal))))

   `(error ((t (:foreground ,red :weight bold))))
   `(warning ((t (:foreground ,yellow :weight bold))))
   `(success ((t (:foreground ,green :weight bold))))
   `(link ((t (:foreground ,blue :underline t))))
   `(link-visited ((t (:foreground ,mauve :underline t))))

   `(show-paren-match ((t (:background ,surface2 :foreground ,peach :weight bold))))
   `(show-paren-mismatch ((t (:background ,red :foreground ,base :weight bold))))
   `(isearch ((t (:background ,peach :foreground ,base))))
   `(lazy-highlight ((t (:background ,yellow :foreground ,base))))
   `(query-replace ((t (:background ,peach :foreground ,base))))

   `(vertico-current ((t (:background ,surface0))))
   `(orderless-match-face-0 ((t (:foreground ,blue :weight bold))))
   `(orderless-match-face-1 ((t (:foreground ,mauve :weight bold))))
   `(orderless-match-face-2 ((t (:foreground ,green :weight bold))))
   `(orderless-match-face-3 ((t (:foreground ,peach :weight bold))))
   `(completions-common-part ((t (:foreground ,blue :weight bold))))

   `(company-tooltip ((t (:foreground ,text :background ,surface0))))
   `(company-tooltip-selection ((t (:background ,surface1))))
   `(company-tooltip-common ((t (:foreground ,blue :weight bold))))
   `(company-scrollbar-bg ((t (:background ,surface1))))
   `(company-scrollbar-fg ((t (:background ,overlay0))))

   `(diff-added ((t (:foreground ,green))))
   `(diff-removed ((t (:foreground ,red))))
   `(diff-changed ((t (:foreground ,yellow))))
   `(magit-diff-added ((t (:foreground ,green))))
   `(magit-diff-removed ((t (:foreground ,red))))
   `(magit-section-heading ((t (:foreground ,mauve :weight bold))))

   `(org-level-1 ((t (:foreground ,blue :weight bold))))
   `(org-level-2 ((t (:foreground ,mauve :weight bold))))
   `(org-level-3 ((t (:foreground ,green :weight bold))))
   `(org-level-4 ((t (:foreground ,yellow :weight bold))))
   `(org-todo ((t (:foreground ,red :weight bold))))
   `(org-done ((t (:foreground ,green :weight bold))))
   `(org-code ((t (:foreground ,peach))))
   `(org-block ((t (:background ,mantle))))
   `(org-document-title ((t (:foreground ,rosewater :weight bold))))))

(provide-theme 'theme-generated)
;;; theme-generated-theme.el ends here
