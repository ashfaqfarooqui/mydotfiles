---
whiskers:
    version: "^2.4.0"
    matrix:
        - flavor
    filename: "generated/{{flavor.identifier}}/nvim-theme.lua"
---
-- Catppuccin {{ flavor.name }} colorscheme for Neovim, generated from the unified
-- theme palette. Generated by theme/justfile — do not edit directly, edit
-- theme/nvim.tera instead.

vim.cmd("highlight clear")
if vim.fn.exists("syntax_on") == 1 then
  vim.cmd("syntax reset")
end
vim.o.background = "dark"
vim.g.colors_name = "theme_generated"

local hl = vim.api.nvim_set_hl

local text = "#{{ flavor.colors.text.hex }}"
local subtext1 = "#{{ flavor.colors.subtext1.hex }}"
local subtext0 = "#{{ flavor.colors.subtext0.hex }}"
local overlay2 = "#{{ flavor.colors.overlay2.hex }}"
local overlay1 = "#{{ flavor.colors.overlay1.hex }}"
local overlay0 = "#{{ flavor.colors.overlay0.hex }}"
local surface2 = "#{{ flavor.colors.surface2.hex }}"
local surface1 = "#{{ flavor.colors.surface1.hex }}"
local surface0 = "#{{ flavor.colors.surface0.hex }}"
local base = "#{{ flavor.colors.base.hex }}"
local mantle = "#{{ flavor.colors.mantle.hex }}"
local crust = "#{{ flavor.colors.crust.hex }}"
local red = "#{{ flavor.colors.red.hex }}"
local maroon = "#{{ flavor.colors.maroon.hex }}"
local peach = "#{{ flavor.colors.peach.hex }}"
local yellow = "#{{ flavor.colors.yellow.hex }}"
local green = "#{{ flavor.colors.green.hex }}"
local teal = "#{{ flavor.colors.teal.hex }}"
local sky = "#{{ flavor.colors.sky.hex }}"
local sapphire = "#{{ flavor.colors.sapphire.hex }}"
local blue = "#{{ flavor.colors.blue.hex }}"
local lavender = "#{{ flavor.colors.lavender.hex }}"
local mauve = "#{{ flavor.colors.mauve.hex }}"
local pink = "#{{ flavor.colors.pink.hex }}"
local flamingo = "#{{ flavor.colors.flamingo.hex }}"
local rosewater = "#{{ flavor.colors.rosewater.hex }}"

-- editor chrome
hl(0, "Normal", { fg = text, bg = base })
hl(0, "NormalFloat", { fg = text, bg = mantle })
hl(0, "NormalNC", { fg = text, bg = base })
hl(0, "FloatBorder", { fg = surface2, bg = mantle })
hl(0, "Cursor", { fg = base, bg = text })
hl(0, "CursorLine", { bg = surface0 })
hl(0, "CursorLineNr", { fg = lavender, bold = true })
hl(0, "LineNr", { fg = overlay0 })
hl(0, "SignColumn", { bg = base })
hl(0, "FoldColumn", { fg = overlay0, bg = base })
hl(0, "ColorColumn", { bg = surface0 })
hl(0, "Visual", { bg = surface1 })
hl(0, "VisualNOS", { bg = surface1 })
hl(0, "Search", { fg = base, bg = yellow })
hl(0, "IncSearch", { fg = base, bg = peach })
hl(0, "CurSearch", { fg = base, bg = peach })
hl(0, "MatchParen", { fg = peach, bg = surface2, bold = true })
hl(0, "Pmenu", { fg = text, bg = surface0 })
hl(0, "PmenuSel", { fg = base, bg = blue })
hl(0, "PmenuSbar", { bg = surface1 })
hl(0, "PmenuThumb", { bg = overlay0 })
hl(0, "StatusLine", { fg = text, bg = mantle })
hl(0, "StatusLineNC", { fg = overlay0, bg = mantle })
hl(0, "TabLine", { fg = overlay0, bg = mantle })
hl(0, "TabLineSel", { fg = text, bg = surface0 })
hl(0, "TabLineFill", { bg = mantle })
hl(0, "WinSeparator", { fg = surface0 })
hl(0, "VertSplit", { fg = surface0 })
hl(0, "NonText", { fg = overlay0 })
hl(0, "Whitespace", { fg = surface2 })
hl(0, "EndOfBuffer", { fg = base })
hl(0, "WinBar", { fg = text, bg = base })
hl(0, "WinBarNC", { fg = overlay1, bg = base })
hl(0, "Title", { fg = blue, bold = true })
hl(0, "Directory", { fg = blue })

-- syntax
hl(0, "Comment", { fg = overlay1, italic = true })
hl(0, "Constant", { fg = peach })
hl(0, "String", { fg = green })
hl(0, "Character", { fg = green })
hl(0, "Number", { fg = peach })
hl(0, "Boolean", { fg = peach })
hl(0, "Float", { fg = peach })
hl(0, "Identifier", { fg = flamingo })
hl(0, "Function", { fg = blue })
hl(0, "Statement", { fg = mauve })
hl(0, "Conditional", { fg = mauve })
hl(0, "Repeat", { fg = mauve })
hl(0, "Label", { fg = sapphire })
hl(0, "Operator", { fg = sky })
hl(0, "Keyword", { fg = mauve })
hl(0, "Exception", { fg = mauve })
hl(0, "PreProc", { fg = mauve })
hl(0, "Include", { fg = mauve })
hl(0, "Define", { fg = mauve })
hl(0, "Macro", { fg = mauve })
hl(0, "Type", { fg = yellow })
hl(0, "StorageClass", { fg = yellow })
hl(0, "Structure", { fg = yellow })
hl(0, "Typedef", { fg = yellow })
hl(0, "Special", { fg = pink })
hl(0, "SpecialChar", { fg = pink })
hl(0, "Tag", { fg = mauve })
hl(0, "Delimiter", { fg = overlay2 })
hl(0, "SpecialComment", { fg = overlay1, italic = true })
hl(0, "Underlined", { fg = blue, underline = true })
hl(0, "Ignore", { fg = overlay0 })
hl(0, "Error", { fg = red })
hl(0, "Todo", { fg = base, bg = yellow, bold = true })

-- diagnostics
hl(0, "DiagnosticError", { fg = red })
hl(0, "DiagnosticWarn", { fg = yellow })
hl(0, "DiagnosticInfo", { fg = sky })
hl(0, "DiagnosticHint", { fg = teal })
hl(0, "DiagnosticOk", { fg = green })
hl(0, "DiagnosticUnderlineError", { undercurl = true, sp = red })
hl(0, "DiagnosticUnderlineWarn", { undercurl = true, sp = yellow })
hl(0, "DiagnosticUnderlineInfo", { undercurl = true, sp = sky })
hl(0, "DiagnosticUnderlineHint", { undercurl = true, sp = teal })

-- diff
hl(0, "DiffAdd", { fg = green, bg = surface0 })
hl(0, "DiffChange", { fg = yellow, bg = surface0 })
hl(0, "DiffDelete", { fg = red, bg = surface0 })
hl(0, "DiffText", { fg = blue, bg = surface1 })

-- git signs
hl(0, "GitSignsAdd", { fg = green })
hl(0, "GitSignsChange", { fg = yellow })
hl(0, "GitSignsDelete", { fg = red })

-- lsp / misc plugin conventions
hl(0, "LspReferenceText", { bg = surface1 })
hl(0, "LspReferenceRead", { bg = surface1 })
hl(0, "LspReferenceWrite", { bg = surface1 })
hl(0, "@variable", { fg = text })
hl(0, "@variable.builtin", { fg = maroon })
hl(0, "@punctuation.bracket", { fg = overlay2 })
hl(0, "@punctuation.delimiter", { fg = overlay2 })
hl(0, "@constructor", { fg = sapphire })
hl(0, "TelescopeSelection", { bg = surface0 })
hl(0, "TelescopeBorder", { fg = surface2 })
hl(0, "TelescopePromptBorder", { fg = surface2 })
hl(0, "NvimTreeNormal", { fg = text, bg = mantle })
hl(0, "NvimTreeFolderIcon", { fg = blue })
hl(0, "CmpItemAbbrMatch", { fg = blue, bold = true })
hl(0, "FlashLabel", { fg = base, bg = peach, bold = true })
