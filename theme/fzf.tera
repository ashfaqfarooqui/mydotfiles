---
whiskers:
    version: "^2.4.0"
    matrix:
        - flavor
    filename: "generated/{{flavor.identifier}}/fzf-theme.zsh"
---
# Catppuccin {{ flavor.name }} colors for fzf.
# Generated by theme/justfile — do not edit directly, edit theme/fzf.tera instead.
export FZF_DEFAULT_OPTS=" \
--color=bg+:#{{ flavor.colors.surface0.hex }},bg:#{{ flavor.colors.base.hex }},spinner:#{{ flavor.colors.rosewater.hex }},hl:#{{ flavor.colors.red.hex }} \
--color=fg:#{{ flavor.colors.text.hex }},header:#{{ flavor.colors.red.hex }},info:#{{ flavor.colors.mauve.hex }},pointer:#{{ flavor.colors.rosewater.hex }} \
--color=marker:#{{ flavor.colors.lavender.hex }},fg+:#{{ flavor.colors.text.hex }},prompt:#{{ flavor.colors.mauve.hex }},hl+:#{{ flavor.colors.red.hex }} \
--color=selected-bg:#{{ flavor.colors.surface1.hex }} \
--multi"
