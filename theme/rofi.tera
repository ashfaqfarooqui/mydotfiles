---
whiskers:
    version: "^2.4.0"
    matrix:
        - flavor
    filename: "generated/{{flavor.identifier}}/rofi-theme.rasi"
---
/*
  Catppuccin {{ flavor.name }} theme for rofi.
  Generated by theme/justfile — do not edit directly, edit theme/rofi.tera instead.

  bg - background
  fg - foreground
  br - border
*/

* {
  main-bg:        #{{ flavor.colors.crust.hex }};
  main-fg:        #{{ flavor.colors.text.hex }};
  main-br:        #{{ flavor.colors.overlay2.hex }};
  input-bg:       #{{ flavor.colors.mantle.hex }};
  select-bg:      #{{ flavor.colors.overlay2.hex }};
  select-fg:      #{{ flavor.colors.crust.hex }};
}
