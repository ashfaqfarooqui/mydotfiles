---
whiskers:
    version: "^2.4.0"
    matrix:
        - flavor
    filename: "generated/{{flavor.identifier}}/ghostty-theme.conf"
font_family: "JetBrainsMono Nerd Font"
---
# Catppuccin {{ flavor.name }} theme for ghostty.
# Generated by theme/justfile — do not edit directly, edit theme/ghostty.tera instead.
# selection-background has no direct Catppuccin equivalent in the original hand-written
# config (it used a custom-blended hex); approximated here as surface1.

font-family = {{ font_family }}

palette = 0=#{{ flavor.colors.surface1.hex }}
palette = 1=#{{ flavor.colors.red.hex }}
palette = 2=#{{ flavor.colors.green.hex }}
palette = 3=#{{ flavor.colors.yellow.hex }}
palette = 4=#{{ flavor.colors.blue.hex }}
palette = 5=#{{ flavor.colors.pink.hex }}
palette = 6=#{{ flavor.colors.teal.hex }}
palette = 7=#{{ flavor.colors.subtext1.hex }}
palette = 8=#{{ flavor.colors.surface2.hex }}
palette = 9=#{{ flavor.colors.red.hex }}
palette = 10=#{{ flavor.colors.green.hex }}
palette = 11=#{{ flavor.colors.yellow.hex }}
palette = 12=#{{ flavor.colors.blue.hex }}
palette = 13=#{{ flavor.colors.pink.hex }}
palette = 14=#{{ flavor.colors.teal.hex }}
palette = 15=#{{ flavor.colors.subtext0.hex }}
background = {{ flavor.colors.base.hex }}
foreground = {{ flavor.colors.text.hex }}
cursor-color = {{ flavor.colors.rosewater.hex }}
selection-background = {{ flavor.colors.surface1.hex }}
selection-foreground = {{ flavor.colors.text.hex }}
