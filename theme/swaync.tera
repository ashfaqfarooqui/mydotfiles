---
whiskers:
    version: "^2.4.0"
    matrix:
        - flavor
    filename: "generated/{{flavor.identifier}}/swaync-theme.css"
---
/*
  Catppuccin {{ flavor.name }} color variables for swaync.
  Generated by theme/justfile — do not edit directly, edit theme/swaync.tera instead.
*/
{% for name, color in flavor.colors %}
@define-color {{ name }} #{{ color.hex }};
{%- endfor %}
