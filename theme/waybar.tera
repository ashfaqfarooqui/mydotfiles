---
whiskers:
    version: "^2.4.0"
    matrix:
        - flavor
    filename: "generated/{{flavor.identifier}}/waybar-theme.css"
---
/*
  Catppuccin {{ flavor.name }} theme for waybar.
  Generated by theme/justfile — do not edit directly, edit theme/waybar.tera instead.

  bg - background
  fg - foreground
  br - border
*/

/* Main Colors */

@define-color main-fg         #{{ flavor.colors.text.hex }};
@define-color main-bg         #{{ flavor.colors.crust.hex }};
@define-color main-br         #{{ flavor.colors.text.hex }};

@define-color active-bg       #{{ flavor.colors.overlay2.hex }};
@define-color active-fg       #{{ flavor.colors.crust.hex }};

@define-color hover-bg        #{{ flavor.colors.surface0.hex }};
@define-color hover-fg        rgba({{ flavor.colors.text.rgb.r }}, {{ flavor.colors.text.rgb.g }}, {{ flavor.colors.text.rgb.b }}, 0.75);

@define-color white           #ffffff;
@define-color black           #000000;

/* Module Colors - 3 distinct shades */

@define-color module-fg       #{{ flavor.colors.rosewater.hex }};
@define-color dark            rgba({{ flavor.colors.mantle.rgb.r }}, {{ flavor.colors.mantle.rgb.g }}, {{ flavor.colors.mantle.rgb.b }}, 0.65);
@define-color medium          rgba({{ flavor.colors.surface0.rgb.r }}, {{ flavor.colors.surface0.rgb.g }}, {{ flavor.colors.surface0.rgb.b }}, 0.65);
@define-color light           rgba({{ flavor.colors.surface1.rgb.r }}, {{ flavor.colors.surface1.rgb.g }}, {{ flavor.colors.surface1.rgb.b }}, 0.65);

/* Glass effect extras */
@define-color glass-border    rgba({{ flavor.colors.text.rgb.r }}, {{ flavor.colors.text.rgb.g }}, {{ flavor.colors.text.rgb.b }}, 0.12);
@define-color glass-highlight rgba(255, 255, 255, 0.07);

@define-color distro-fg       #{{ flavor.colors.crust.hex }};
@define-color distro-bg       #{{ flavor.colors.overlay2.hex }};
@define-color power           #{{ flavor.colors.red.hex }};

/* State Colors */

@define-color good            #{{ flavor.colors.rosewater.hex }};
@define-color warning         #{{ flavor.colors.yellow.hex }};
@define-color critical        #{{ flavor.colors.red.hex }};
@define-color full            #{{ flavor.colors.green.hex }};
@define-color charging        #{{ flavor.colors.text.hex }};
@define-color overlay0        #{{ flavor.colors.overlay0.hex }};
