---
whiskers:
    version: "^2.4.0"
    matrix:
        - flavor
    filename: "generated/{{flavor.identifier}}/hyprlock-colors.conf"
font_family: "JetBrainsMono Nerd Font"
---
# Catppuccin {{ flavor.name }} color variables for hyprlock.
# Generated by theme/justfile — do not edit directly, edit theme/hyprlock.tera instead.
$font = {{ font_family }}
{% for name, color in flavor.colors %}
${{ name }} = rgb({{ color.hex }})
${{ name }}Alpha = {{ color.hex }}
{% endfor %}
