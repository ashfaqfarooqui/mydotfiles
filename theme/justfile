# Print out all recipes when running `just`
_default:
    @just --list

output := "generated"
native_flavors := "mocha latte frappe macchiato"
# Single source of truth for the shell-wide font (theme/font.json) — passed
# to whiskers as a frontmatter override, same mechanism `generate-custom`
# already uses for --color-overrides. Templates that don't declare a
# `font_family` frontmatter default just ignore the override.
font_family := `jq -r .family font.json`

# Render every template for every native Catppuccin flavor into generated/<flavor>/...
generate:
    whiskers hyprland.tera
    whiskers hyprlock.tera --overrides "{\"font_family\": \"{{font_family}}\"}"
    whiskers waybar.tera --overrides "{\"font_family\": \"{{font_family}}\"}"
    whiskers ghostty.tera --overrides "{\"font_family\": \"{{font_family}}\"}"
    whiskers rofi.tera
    whiskers swaync.tera
    whiskers btop.tera
    whiskers lazygit.tera
    whiskers fzf.tera
    whiskers nvim.tera --overrides "{\"font_family\": \"{{font_family}}\"}"
    whiskers emacs.tera
    whiskers quickshell.tera --overrides "{\"font_family\": \"{{font_family}}\"}"
    whiskers kitty-font.tera --overrides "{\"font_family\": \"{{font_family}}\"}"

# Render every template for a non-Catppuccin theme (theme/palettes/<name>.json) into
# generated/<name>/..., by repainting all 26 Catppuccin color slots via
# `--color-overrides` and stripping each template's frontmatter so whiskers prints
# to stdout instead of writing to the native flavor's own output path.
generate-custom name:
    #!/usr/bin/env bash
    set -euo pipefail
    mkdir -p "{{output}}/{{name}}"
    overrides=$(jq -c "{mocha: .}" "palettes/{{name}}.json")
    display_name=$(case "{{name}}" in
        nord) echo "Nord" ;;
        gruvbox) echo "Gruvbox" ;;
        dracula) echo "Dracula" ;;
        tokyonight) echo "Tokyo Night" ;;
        rosepine) echo "Rose Pine" ;;
        everforest) echo "Everforest" ;;
        kanagawa) echo "Kanagawa" ;;
        matte-black) echo "Matte Black" ;;
        osaka-jade) echo "Osaka Jade" ;;
        *) echo "{{name}}" ;;
    esac)
    declare -A files=(
        [hyprland.tera]=hypr-theme.lua
        [hyprlock.tera]=hyprlock-colors.conf
        [waybar.tera]=waybar-theme.css
        [ghostty.tera]=ghostty-theme.conf
        [rofi.tera]=rofi-theme.rasi
        [swaync.tera]=swaync-theme.css
        [btop.tera]=btop-theme.theme
        [lazygit.tera]=lazygit-config.yml
        [fzf.tera]=fzf-theme.zsh
        [nvim.tera]=nvim-theme.lua
        [emacs.tera]=emacs-theme.el
        [quickshell.tera]=quickshell-theme.json
        [kitty-font.tera]=kitty-font.conf
    )
    font_family=$(jq -r .family font.json)
    for tmpl in "${!files[@]}"; do
        out="{{output}}/{{name}}/${files[$tmpl]}"
        awk '/^---$/{c++; next} c>=2' "$tmpl" \
            | whiskers - -f mocha --color-overrides "$overrides" \
                --overrides "{\"font_family\": \"$font_family\"}" \
            | sed "s/Catppuccin Mocha/${display_name}/g" \
            > "$out"
    done

# Rebuild the 2x2 color-swatch PNGs (theme/swatches/<name>.png) used as row icons
# in the theme picker. Only needs re-running if a palette changes.
swatches: generate
    #!/usr/bin/env bash
    set -euo pipefail
    for name in nord gruvbox dracula tokyonight rosepine everforest kanagawa matte-black osaka-jade; do
        just -f "{{justfile()}}" generate-custom "$name"
    done
    ./make-swatches.sh

# Remove generated output
clean:
    rm -rf {{output}}

# Apply a theme (native: mocha/latte/frappe/macchiato, or custom: nord/gruvbox/
# dracula/tokyonight/rosepine) to the live, stowed configs and reload apps.
# Usage: just -f theme/justfile apply mocha
apply name:
    #!/usr/bin/env bash
    set -euo pipefail
    if [[ " {{native_flavors}} " == *" {{name}} "* ]]; then
        just -f "{{justfile()}}" generate
    else
        just -f "{{justfile()}}" generate-custom "{{name}}"
    fi
    cp "{{output}}/{{name}}/hypr-theme.lua" ../hypr/.config/hypr/theme.lua
    cp "{{output}}/{{name}}/hyprlock-colors.conf" ../hypr/.config/hypr/hyprlock-colors.conf
    cp "{{output}}/{{name}}/waybar-theme.css" ../waybar/.config/waybar/theme.css
    cp "{{output}}/{{name}}/ghostty-theme.conf" ../ghostty/.config/ghostty/theme.conf
    cp "{{output}}/{{name}}/rofi-theme.rasi" ../rofi/.config/rofi/theme.rasi
    cp "{{output}}/{{name}}/swaync-theme.css" ../swaync/.config/swaync/theme.css
    mkdir -p ../btop/.config/btop/themes
    cp "{{output}}/{{name}}/btop-theme.theme" ../btop/.config/btop/themes/current.theme
    cp "{{output}}/{{name}}/lazygit-config.yml" ../lazygit/.config/lazygit/config.yml
    cp "{{output}}/{{name}}/fzf-theme.zsh" ../zsh/conf/fzf-theme.zsh
    cp "{{output}}/{{name}}/nvim-theme.lua" ../nvim/.config/nvim/colors/theme_generated.lua
    mkdir -p ../doom/.doom.d/themes
    cp "{{output}}/{{name}}/emacs-theme.el" ../doom/.doom.d/themes/theme-generated-theme.el
    cp "{{output}}/{{name}}/quickshell-theme.json" ../quickshell/.config/quickshell/theme/theme.json
    cp "{{output}}/{{name}}/kitty-font.conf" ../kitty/.config/kitty/font.conf
    python3 apply-starship.py "{{output}}/{{name}}/hypr-theme.lua" ../starship/.config/starship.toml
    # Apps with no include/variable mechanism for font-family get their
    # literal patched in place instead of a full generated file — same
    # single source (theme/font.json), just a narrower sed/jq edit.
    font_family=$(jq -r .family font.json)
    jq --arg f "$font_family" '.["editor.fontFamily"] = $f' ../vscode/settings.json > ../vscode/settings.json.tmp \
        && mv ../vscode/settings.json.tmp ../vscode/settings.json
    # zed's settings.json is JSONC (has `//` comments), which jq can't parse
    # — sed on the specific keys instead, so comments/formatting survive.
    sed -i \
        -e "s/\"ui_font_family\": \"[^\"]*\"/\"ui_font_family\": \"$font_family\"/" \
        -e "s/\"buffer_font_family\": \"[^\"]*\"/\"buffer_font_family\": \"$font_family\"/" \
        -e "s/\"font_family\": \"[^\"]*\"/\"font_family\": \"$font_family\"/" \
        ../zed/.config/zed/settings.json
    # swaync's `* { all: unset; font-family: ...; }` needs its own explicit
    # font-family (the imported theme.css can't supply it — all:unset wipes
    # any inherited/earlier value for this same selector), so this is a
    # direct patch rather than a generated include.
    sed -i "s/font-family: \".*\";/font-family: \"$font_family\";/" ../swaync/.config/swaync/style.css
    # doom emacs' doom-font/doom-big-font/doom-variable-pitch-font each take
    # a font-spec :family string — patch all three in one pass. (Previously
    # "JetBrainsMono Nerd Font Mono", a different installed variant than
    # every other app's "JetBrainsMono Nerd Font" — unified here.)
    sed -i "s/:family \"[^\"]*\"/:family \"$font_family\"/g" ../doom/.doom.d/config.el
    hyprctl reload || true
    pkill -SIGUSR2 waybar || true
    pkill -SIGUSR2 ghostty || true
    # swaync was replaced by quickshell.service in the boot cutover
    # (28a88bf); swaync-client blocks forever waiting for a D-Bus service
    # that no longer exists, so it's dropped rather than left as a hang.
    # Themes with a dedicated Wallpapers/<name>/ folder pick a random image from it;
    # native flavors without one (the four Catppuccin variants, which share the
    # top-level wallpaper pool instead of having their own folder) fall back to
    # a fixed default so re-applying one reliably restores the same wallpaper.
    declare -A default_wallpaper=(
        [mocha]="../Wallpapers/DSC_0749-1.jpg"
        [latte]="../Wallpapers/DSC_0042.jpg"
        [frappe]="../Wallpapers/DSC_0194-1.jpg"
        [macchiato]="../Wallpapers/DSC_0515.JPG"
    )
    wallpaper_dir="../Wallpapers/{{name}}"
    if [ -d "$wallpaper_dir" ] && [ -n "$(ls -A "$wallpaper_dir" 2>/dev/null)" ]; then
        wallpaper=$(find "$wallpaper_dir" -type f | shuf -n1)
    else
        wallpaper="${default_wallpaper[{{name}}]:-}"
    fi
    if [ -n "$wallpaper" ]; then
        # hyprpaper 0.8.4 has no working "reload" IPC verb, and an empty monitor
        # field silently no-ops — set it per connected monitor explicitly.
        for mon in $(hyprctl monitors -j | jq -r '.[].name'); do
            hyprctl hyprpaper wallpaper "$mon,$wallpaper" || true
        done
        wallpaper_abs=$(realpath "$wallpaper")
        sed -i "s|^    path = .*|    path = $wallpaper_abs|" ../hypr/.config/hypr/hyprlock.conf
    fi
    echo "{{name}}" > .current
    echo "Applied {{name}}. rofi and hyprlock pick up the new theme next time they're launched."
