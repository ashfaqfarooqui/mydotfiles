---
whiskers:
    version: "^2.4.0"
    matrix:
        - flavor
    filename: "generated/{{flavor.identifier}}/hypr-theme.lua"
---
-- Catppuccin {{ flavor.name }} color palette for Hyprland.
-- Generated by theme/justfile — do not edit directly, edit theme/hyprland.tera instead.
local M = {}

{% for name, color in flavor.colors -%}
M.{{ name }} = "rgb({{ color.hex }})"
{% endfor %}
return M
