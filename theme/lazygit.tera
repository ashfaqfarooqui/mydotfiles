---
whiskers:
    version: "^2.4.0"
    matrix:
        - flavor
    filename: "generated/{{flavor.identifier}}/lazygit-config.yml"
---
# Catppuccin {{ flavor.name }} theme for lazygit.
# Generated by theme/justfile — do not edit directly, edit theme/lazygit.tera instead.

gui:
  theme:
    activeBorderColor:
      - '#{{ flavor.colors.sky.hex }}'
      - bold
    inactiveBorderColor:
      - '#{{ flavor.colors.subtext0.hex }}'
    optionsTextColor:
      - '#{{ flavor.colors.blue.hex }}'
    selectedLineBgColor:
      - '#{{ flavor.colors.surface0.hex }}'
    cherryPickedCommitBgColor:
      - '#{{ flavor.colors.surface1.hex }}'
    cherryPickedCommitFgColor:
      - '#{{ flavor.colors.sky.hex }}'
    unstagedChangesColor:
      - '#{{ flavor.colors.red.hex }}'
    defaultFgColor:
      - '#{{ flavor.colors.text.hex }}'
    searchingActiveBorderColor:
      - '#{{ flavor.colors.yellow.hex }}'

authorColors:
  '*': '#{{ flavor.colors.lavender.hex }}'
